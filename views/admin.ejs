<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Panel - Add Video</title>
    <style>
        body { font-family: Arial, sans-serif; background-color: #121212; color: #fff; padding: 20px; text-align: center; }
        .form-container { background: #1e1e1e; padding: 20px; border-radius: 10px; max-width: 400px; margin: auto; border: 1px solid #333; }
        input, textarea { width: 90%; padding: 10px; margin: 10px 0; border-radius: 5px; border: none; background: #333; color: white; font-family: Arial, sans-serif; box-sizing: border-box; }
        textarea { resize: vertical; height: 80px; }
        button { background: #ff9800; color: #000; padding: 12px 20px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold; width: 90%; }
        button:hover { background: #e08b00; }
    </style>
</head>
<body>
    <h2>Add New Video</h2>
    <div class="form-container">
        <form action="/add-post" method="POST">
            <input type="text" name="title" placeholder="Video Title" required>
            
            <input type="text" name="thumbnail" placeholder="Main Thumbnail Image URL" required>
            
            <input type="text" name="screenshots" placeholder="Screenshot URL (Optional, separate by comma for multiple)">
            
            <textarea name="description" placeholder="Write video details or description here..."></textarea>
            
            <input type="text" name="videoId" placeholder="Telegram File ID" required>
            
            <button type="submit">Upload Video</button>
        </form>
    </div>
    <br>
    <a href="/" style="color: #ff9800; text-decoration: none;">← Go to Homepage</a>
</body>
</html>