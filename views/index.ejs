<script>
        function playAdAndRedirect(videoId) {
            const btn = document.getElementById('btn-' + videoId);
            const msg = document.getElementById('msg-' + videoId);

            btn.disabled = true;
            msg.innerText = "Loading ad, please wait...";

            // টেলিগ্রাম বটের সঠিক ডিপ লিংক ফরম্যাট (যা বটে ক্লিক করলেই অটো স্টার্ট কমান্ড পাঠাবে)
            const botUsername = "vairalvideoszarabot"; // আপনার টেলিগ্রাম বটের ইউজারনেম
            const targetUrl = `https://t.me/${botUsername}?start=${videoId}`;

            const doRedirect = () => {
                msg.innerText = "Opening video in Telegram...";
                if (window.Telegram && window.Telegram.WebApp) {
                    window.Telegram.WebApp.openTelegramLink(targetUrl);
                    setTimeout(() => {
                        window.Telegram.WebApp.close();
                    }, 500);
                } else {
                    window.location.href = targetUrl;
                }
            };

            if (typeof show_11691107 === 'function') {
                show_11691107().then(() => {
                    doRedirect();
                }).catch((e) => {
                    console.error("Ad error:", e);
                    doRedirect(); // অ্যাড স্কিপ বা এরর হলেও যেন ভিডিও মিস না হয়
                });
            } else {
                doRedirect();
            }
        }
    </script>