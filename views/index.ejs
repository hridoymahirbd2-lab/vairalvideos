<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TG PREMIUM</title>

    <!-- Monetag Rewarded SDK -->
    <script src='//libtl.com/sdk.js' data-zone='11691107' data-sdk='show_11691107'></script>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #121212;
            color: #ffffff;
            text-align: center;
            padding: 15px;
            margin: 0;
        }
        h1 {
            color: #fff;
            font-size: 20px;
            margin-bottom: 15px;
        }
        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }
        .post-card {
            background: #1e1e1e;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 350px;
            padding: 15px;
            text-align: center;
            box-sizing: border-box;
            border: 1px solid #333;
        }
        .post-card img {
            width: 100%;
            border-radius: 8px;
            height: 200px;
            object-fit: cover;
        }
        .post-card h3 {
            margin: 12px 0;
            font-size: 16px;
            color: #fff;
        }
        .btn-unlock {
            display: block;
            width: 100%;
            background-color: #ff9800;
            color: #000;
            padding: 14px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            border: none;
            cursor: pointer;
            font-size: 16px;
            box-sizing: border-box;
            transition: 0.2s;
        }
        .btn-download {
            display: block;
            width: 100%;
            background-color: #28a745;
            color: #fff;
            padding: 14px;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            border: none;
            cursor: pointer;
            font-size: 16px;
            box-sizing: border-box;
        }
        .status-msg {
            margin-top: 10px;
            font-size: 13px;
            color: #aaa;
        }
    </style>
</head>
<body>

    <h1>TG PREMIUM - VIRAL HUB</h1>

    <div class="container">
        <% if (typeof posts !== 'undefined' && posts && posts.length > 0) { %>
            <% posts.forEach(function(post) { %>
                <div class="post-card">
                    <% if (post.thumbnail) { %>
                        <img src="<%= post.thumbnail %>" alt="Thumbnail">
                    <% } %>
                    <h3><%= post.title %></h3>
                    
                    <!-- ডায়নামিক বাটন যা অ্যাড দেখার পর DOWNLOAD NOW এ রূপ নেবে -->
                    <div id="btn-container-<%= post.videoId %>">
                        <button class="btn-unlock" id="btn-<%= post.videoId %>" onclick="watchAdsAndUnlock('<%= post.videoId %>')">🔒 Unlock Video</button>
                    </div>
                    <div id="msg-<%= post.videoId %>" class="status-msg">Click Unlock Video to watch ads.</div>
                </div>
            <% }); %>
        <% } else { %>
            <div style="color: #aaa; margin-top: 30px;">
                <p>No videos available yet. <br><a href="/admin" style="color: #ff9800;">Go to Admin Panel</a> to add posts.</p>
            </div>
        <% } %>
    </div>

    <script>
        function watchAdsAndUnlock(videoId) {
            const container = document.getElementById('btn-container-' + videoId);
            const msg = document.getElementById('msg-' + videoId);

            if (msg) msg.innerText = "Loading ad, please watch completely...";

            const botUsername = "vairalvideoszarabot"; 
            const targetUrl = `https://t.me/${botUsername}?start=` + videoId;

            const unlockAction = () => {
                if (msg) msg.innerText = "All ads completed! Download unlocked.";
                // ঠিক অন্য বোর্ডের সাইটের মতো সবুজ রঙের DOWNLOAD NOW বাটন তৈরি করা হলো
                container.innerHTML = `<a href="${targetUrl}" class="btn-download" target="_blank">📥 DOWNLOAD NOW</a>`;
                
                if (window.Telegram && window.Telegram.WebApp) {
                    window.Telegram.WebApp.openTelegramLink(targetUrl);
                }
            };

            if (typeof show_11691107 === 'function') {
                show_11691107().then(() => {
                    unlockAction();
                }).catch((e) => {
                    console.error("Ad error:", e);
                    unlockAction(); // অ্যাড কোনো কারণে ফেইল করলেও যেন ইউজারের প্রবলেম না হয়
                });
            } else {
                unlockAction();
            }
        }
    </script>

</body>
</html>