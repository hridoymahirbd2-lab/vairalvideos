<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Video Gallery</title>

    <!-- Monetag Telegram SDK -->
    <script src='//libtl.com/sdk.js' data-zone='11691107' data-sdk='show_11691107'></script>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f9;
            text-align: center;
            padding: 20px;
            margin: 0;
        }
        h1 {
            color: #333;
            margin-bottom: 20px;
        }
        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }
        .post-card {
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            width: 300px;
            padding: 15px;
            text-align: center;
            box-sizing: border-box;
        }
        .post-card img {
            width: 100%;
            border-radius: 8px;
            height: 180px;
            object-fit: cover;
        }
        .post-card h3 {
            margin: 12px 0;
            font-size: 18px;
            color: #333;
        }
        .btn {
            display: inline-block;
            background-color: #0088cc;
            color: white;
            padding: 12px 24px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            border: none;
            cursor: pointer;
            width: 100%;
            font-size: 15px;
            transition: background 0.3s;
        }
        .btn:hover {
            background-color: #006699;
        }
        .btn:disabled {
            background-color: #cccccc;
            cursor: not-allowed;
        }
        .status-msg {
            margin-top: 8px;
            font-size: 13px;
            color: #666;
        }
    </style>
</head>
<body>

    <h1>Video Gallery</h1>

    <div class="container">
        <% if (posts && posts.length > 0) { %>
            <% posts.forEach(post => { %>
                <div class="post-card">
                    <% if (post.thumbnail) { %>
                        <img src="<%= post.thumbnail %>" alt="Thumbnail">
                    <% } %>
                    <h3><%= post.title %></h3>
                    <button class="btn" id="btn-<%= post.videoId %>" onclick="playAdAndRedirect('<%= post.videoId %>')">Watch Video</button>
                    <div id="msg-<%= post.videoId %>" class="status-msg"></div>
                </div>
            <% }) %>
        <% } else { %>
            <p>No videos available yet.</p>
        <% } %>
    </div>

    <script>
        function playAdAndRedirect(videoId) {
            const btn = document.getElementById('btn-' + videoId);
            const msg = document.getElementById('msg-' + videoId);

            btn.disabled = true;
            msg.innerText = "Loading ad, please wait...";

            // Monetag Rewarded Interstitial SDK কল করা হচ্ছে
            if (typeof show_11691107 === 'function') {
                show_11691107().then(() => {
                    // অ্যাড সফলভাবে দেখা শেষ হলে টেলিগ্রাম বটে পাঠানো হবে
                    msg.innerText = "Redirecting to video...";
                    window.location.href = "https://t.me/vairalvideoszarabot?start=" + videoId;
                }).catch((e) => {
                    // কোনো কারণে অ্যাড লোড না হলে সরাসরি বটে পাঠানো হবে
                    console.error("Ad error:", e);
                    window.location.href = "https://t.me/vairalvideoszarabot?start=" + videoId;
                });
            } else {
                // SDK কাজ না করলে সরাসরি বট লিংকে যাবে
                window.location.href = "https://t.me/vairalvideoszarabot?start=" + videoId;
            }
        }
    </script>

</body>
</html>